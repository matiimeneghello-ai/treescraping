# Copiá este archivo a .env y pegá tus credenciales.

# --- Apify (requerido para scanear) ---
# Token en https://console.apify.com/account/integrations
# Plan free: USD 5/mes de crédito. Un scan de ~240 negocios cuesta centavos.
APIFY_TOKEN=

# --- PageSpeed Insights (opcional, recomendado) ---
# Sin key, el reporte oculta la sección de velocidad (cuota anónima muy baja).
# Con key (gratis, 25k/día): scores reales de Google en el diagnóstico.
# Sacá una key en https://developers.google.com/speed/docs/insights/v5/get-started
PSI_KEY=

# --- Dashboard (opcional) ---
# Si la seteás, el botón "Correr scan" pide esta clave (evita que cualquiera gaste crédito).
DASHBOARD_KEY=

# --- Apify memoria (opcional) ---
# Vacío = usa la RAM del actor (estable). Forzar 4096 hace abortar en el plan free.
APIFY_MEMORY=
